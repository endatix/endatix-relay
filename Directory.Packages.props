<?xml version="1.0" encoding="utf-8"?>
<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <!-- Engine runtime deps: Microsoft.Extensions abstractions + OpenFeature only. No EF, no Endatix. -->
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
        <PackageVersion Include="OpenFeature" Version="2.14.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- Test-only -->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageVersion Include="NSubstitute" Version="6.2.0" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
        <PackageVersion Include="coverlet.collector" Version="10.1.0" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
        <!-- Integration-test-only (real-DB suite via Testcontainers) -->
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
        <PackageVersion Include="Npgsql" Version="10.0.3" />
        <PackageVersion Include="Testcontainers.MsSql" Version="4.12.0" />
        <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
        <!-- NU1903 (GHSA-846f-f764-76mx): lift SqlClient's transitive Pkcs 9.0.13 to the patched 10.0.14 line. -->
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    </ItemGroup>
</Project>
